%%====================================================================
%% Messages (as records)
%%====================================================================

%% Message: SYS_STATUS (ID: 1)
%% Sensor and subsystem status information. Provides a compact representation of sensor/subsystem status and a few other basic statistics.

-define(SYS_STATUS_ID, 1).

-record(sys_status, {
    onboard_control_sensors_present,
    onboard_control_sensors_enabled,
    onboard_control_sensors_health,
    load,
    voltage_battery,
    current_battery,
    battery_remaining,
    drop_rate_comm,
    errors_comm,
    errors_count1,
    errors_count2,
    errors_count3,
    errors_count4,
    onboard_control_sensors_present_extended,
    onboard_control_sensors_enabled_extended,
    onboard_control_sensors_health_extended
}).

%% Message: SYSTEM_TIME (ID: 2)
%% The system time is the time of the sender's master clock.
%% This can be emitted by flight controllers, onboard computers, or other components in the MAVLink network.
%% Components that are using a less reliable time source, such as a battery-backed real time clock, can choose to match their system clock to that of a system that indicates a more recent time.
%% This allows more broadly accurate date stamping of logs, and so on.
%% If precise time synchronization is needed then use TIMESYNC instead.

-define(SYSTEM_TIME_ID, 2).

-record(system_time, {
    time_unix_usec,
    time_boot_ms
}).

%% Message: PING (ID: 4)
%% A ping message either requesting or responding to a ping. This allows to measure the system latencies, including serial port, radio modem and UDP connections. The ping microservice is documented at https://mavlink.io/en/services/ping.html

-define(PING_ID, 4).

-record(ping, {
    time_usec,
    seq,
    target_system,
    target_component
}).

%% Message: CHANGE_OPERATOR_CONTROL (ID: 5)
%% Request to control this MAV

-define(CHANGE_OPERATOR_CONTROL_ID, 5).

-record(change_operator_control, {
    target_system,
    control_request,
    version,
    passkey
}).

%% Message: CHANGE_OPERATOR_CONTROL_ACK (ID: 6)
%% Accept / deny control of this MAV

-define(CHANGE_OPERATOR_CONTROL_ACK_ID, 6).

-record(change_operator_control_ack, {
    gcs_system_id,
    control_request,
    ack
}).

%% Message: AUTH_KEY (ID: 7)
%% Emit an encrypted signature / key identifying this system. PLEASE NOTE: This protocol has been kept simple, so transmitting the key requires an encrypted channel for true safety.

-define(AUTH_KEY_ID, 7).

-record(auth_key, {
    key
}).

%% Message: LINK_NODE_STATUS (ID: 8)
%% Status generated in each node in the communication chain and injected into MAVLink stream.

-define(LINK_NODE_STATUS_ID, 8).

-record(link_node_status, {
    timestamp,
    tx_buf,
    rx_buf,
    tx_rate,
    rx_rate,
    rx_parse_err,
    tx_overflows,
    rx_overflows,
    messages_sent,
    messages_received,
    messages_lost
}).

%% Message: SET_MODE (ID: 11)
%% Set the system mode, as defined by enum MAV_MODE_FLAG. There is no target component id as the mode is by definition for the overall aircraft, not only for one component.

-define(SET_MODE_ID, 11).

-record(set_mode, {
    target_system,
    base_mode,
    custom_mode
}).

%% Message: PARAM_REQUEST_READ (ID: 20)
%% Request to read the onboard parameter with the param_id string id. Onboard parameters are stored as key[const char*] -> value[float]. This allows to send a parameter to any other component (such as the GCS) without the need of previous knowledge of possible parameter names. Thus the same GCS can store different parameters for different autopilots. See also https://mavlink.io/en/services/parameter.html for a full documentation of QGroundControl and IMU code.

-define(PARAM_REQUEST_READ_ID, 20).

-record(param_request_read, {
    target_system,
    target_component,
    param_id,
    param_index
}).

%% Message: PARAM_REQUEST_LIST (ID: 21)
%% Request all parameters of this component. After this request, all parameters are emitted. The parameter microservice is documented at https://mavlink.io/en/services/parameter.html

-define(PARAM_REQUEST_LIST_ID, 21).

-record(param_request_list, {
    target_system,
    target_component
}).

%% Message: PARAM_VALUE (ID: 22)
%% Emit the value of a onboard parameter. The inclusion of param_count and param_index in the message allows the recipient to keep track of received parameters and allows him to re-request missing parameters after a loss or timeout. The parameter microservice is documented at https://mavlink.io/en/services/parameter.html

-define(PARAM_VALUE_ID, 22).

-record(param_value, {
    param_id,
    param_value,
    param_type,
    param_count,
    param_index
}).

%% Message: PARAM_SET (ID: 23)
%% Set a parameter value (write new value to permanent storage).
%% The receiving component should acknowledge the new parameter value by broadcasting a PARAM_VALUE message (broadcasting ensures that multiple GCS all have an up-to-date list of all parameters). If the sending GCS did not receive a PARAM_VALUE within its timeout time, it should re-send the PARAM_SET message. The parameter microservice is documented at https://mavlink.io/en/services/parameter.html.

-define(PARAM_SET_ID, 23).

-record(param_set, {
    target_system,
    target_component,
    param_id,
    param_value,
